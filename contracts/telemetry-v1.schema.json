{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EdgeGuard telemetry 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device_id", "boot_id", "sequence_number", "timestamp", "uptime_ms", "sensors", "actuators"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "device_id": {"$ref": "#/$defs/identifier"},
    "boot_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 36},
    "sequence_number": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "timestamp": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|\\+00:00)$",
      "format": "date-time"
    },
    "uptime_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "sensors": {
      "type": "object", "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/sensor"}
    },
    "actuators": {
      "type": "object", "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/actuator"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 64, "not": {"pattern": "[^A-Za-z0-9_-]"}},
    "sensor": {
      "type": "object", "additionalProperties": false,
      "required": ["measurement", "unit", "status", "value"],
      "properties": {
        "measurement": {"const": "gas_signal"},
        "unit": {"const": "normalized"},
        "status": {"enum": ["ok", "unavailable"]},
        "value": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "if": {"properties": {"status": {"const": "ok"}}},
      "then": {"properties": {"value": {"type": "number"}}},
      "else": {"properties": {"value": {"type": "null"}}}
    },
    "actuator": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "unit", "mode", "commanded", "reported", "feedback"],
      "properties": {
        "kind": {"enum": ["light", "fan", "servo"]},
        "unit": {"enum": ["binary", "degrees"]},
        "mode": {"enum": ["auto", "manual"]},
        "commanded": {"type": "integer", "minimum": 0, "maximum": 180},
        "reported": {"type": ["integer", "null"], "minimum": 0, "maximum": 180},
        "feedback": {"enum": ["simulated", "measured", "unavailable"]}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "servo"}}},
          "then": {"properties": {"unit": {"const": "degrees"}}},
          "else": {"properties": {"unit": {"const": "binary"}, "commanded": {"maximum": 1}, "reported": {"maximum": 1}}}
        },
        {
          "if": {"properties": {"feedback": {"const": "unavailable"}}},
          "then": {"properties": {"reported": {"type": "null"}}},
          "else": {"properties": {"reported": {"type": "integer"}}}
        }
      ]
    }
  }
}
